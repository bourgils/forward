{
  "name": "@bourgils/forward",
  "version": "0.5.0",
  "description": "A fast, temporary CLI runtime for JavaScript projects. Run commands without polluting your project.",
  "bin": {
    "fwd": "./bin/fwd.js"
  },
  "type": "module",
  "main": "src/cli/index.js",
  "files": [
    "bin",
    "src",
    "dist"
  ],
  "scripts": {
    "dev": "node bin/fwd.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "build": "tsup src/cli/index.js --format esm --platform node --out-dir dist/cli"
  },
  "keywords": [
    "cli",
    "dev",
    "tooling",
    "vite",
    "nextjs",
    "zero-install",
    "temporary",
    "runtime",
    "project-runner",
    "npm",
    "sandbox",
    "isolated",
    "scripts",
    "pipe",
    "frontend",
    "developer-experience"
  ],
  "author": "bourgils",
  "license": "MIT",
  "dependencies": {
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "console-table-printer": "^2.12.1",
    "dotenv": "^16.5.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "http-proxy": "^1.18.1",
    "inquirer": "^12.5.2",
    "node-forge": "^1.3.1",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "pretty-bytes": "^6.1.1",
    "pretty-ms": "^9.2.0",
    "prompts": "^2.4.2",
    "ps-tree": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bourgils/forward.git"
  },
  "bugs": {
    "url": "https://github.com/bourgils/forward/issues"
  },
  "homepage": "https://github.com/bourgils/forward#readme"
}
